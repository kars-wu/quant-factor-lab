# 数据库路径（默认 data/stock.db）
DB_PATH=data/stock.db

# 数据源（akshare 限速：每分钟请求数）
AKSHARE_RPM=50

# Tushare（可选，备用数据源）
TUSHARE_TOKEN=

# 任务监控通知（可选；scheduler/monitor.py 用，留空则不发通知）
MONITOR_WEBHOOK_URL=

# 多 agent 的 LLM（可选；不配置则走启发式，完全离线可跑）
# 任何兼容 /chat/completions 的服务都可以
MA_LLM_BASE_URL=
MA_LLM_API_KEY=
MA_LLM_MODEL=
